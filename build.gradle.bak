apply plugin: 'java'

version = "${mod_version}"
group = "${mod_group_id}"
archivesBaseName = "${mod_name}-${minecraft_version}"

java {
    sourceCompatibility = JavaVersion.VERSION_21
    targetCompatibility = JavaVersion.VERSION_21
}

java.toolchain.languageVersion = JavaLanguageVersion.of(21)

compileJava.options.encoding = 'UTF-8'

repositories {
    mavenCentral()
}

dependencies {
    compileOnly files('libs/forge-1.12.2-14.23.5.2860.jar')
    compileOnly files('libs/forge-1.12.2-14.23.5.2860-universal.jar')
    // Use unsigned copy to avoid JAR signature SecurityException at test runtime
    implementation files('libs/forge-1.12.2-14.23.5.2860-universal-unsigned.jar')
    implementation 'org.apache.logging.log4j:log4j-api:2.11.2'
    implementation 'com.google.code.gson:gson:2.11.0'
    implementation 'com.google.guava:guava:17.0'
    implementation 'commons-io:commons-io:2.4'
    annotationProcessor 'com.google.code.gson:gson:2.11.0'
    annotationProcessor 'com.google.guava:guava:17.0'
    annotationProcessor 'commons-io:commons-io:2.4'
    implementation 'org.jetbrains:annotations:24.0.0'
    testImplementation 'org.junit.jupiter:junit-jupiter:5.10.3'
    testRuntimeOnly 'org.junit.platform:junit-platform-launcher:1.10.3'
}

// Phase 4 STEP 5: adapter layer — SRG method names used for Minecraft classes
// where the universal jar has SRG method names (MCP class paths but SRG methods).
sourceSets {
    main {
        java {
            include 'levosilimo/everlastingskins/*.java'
            include 'levosilimo/everlastingskins/enums/*.java'
            include 'levosilimo/everlastingskins/util/*.java'
            // SkinRestorer and I18nUtils now included — they use
            // SRG redirect constants ({@link levosilimo.everlastingskins.SRG}) for Minecraft methods.
            include 'levosilimo/everlastingskins/skinchanger/*.java'
            include 'levosilimo/everlastingskins/skinchanger/requests/mineskin/*.java'
            include 'levosilimo/everlastingskins/skinchanger/responses/*.java'
            include 'levosilimo/everlastingskins/skinchanger/responses/mineskin/*.java'
            include 'levosilimo/everlastingskins/skinchanger/responses/mojang/*.java'
            include 'levosilimo/everlastingskins/skinchanger/responses/profile/*.java'
            include 'levosilimo/everlastingskins/skinchanger/responses/uuid/*.java'
            include 'net/minecraft/util/*.java'
            exclude 'levosilimo/everlastingskins/mixin/**'
            exclude 'levosilimo/everlastingskins/libs/**'
            // SkinCommand.java uses 1.21 Brigadier — STEP 6 rewrites it
            exclude 'levosilimo/everlastingskins/skinchanger/SkinCommand.java'
            // CommandRegistrationHandler.java uses 1.21 event bus
            exclude 'levosilimo/everlastingskins/CommandRegistrationHandler.java'
            // RandomMojangSkin.java references SkinCommand.mojangAPI
            exclude 'levosilimo/everlastingskins/skinchanger/RandomMojangSkin.java'
            // MineSkinApiHttpImpl.java references Config (compiles now but kept excluded for Phase 5)
            include 'levosilimo/everlastingskins/skinchanger/MineSkinApiHttpImpl.java'
        }
    }
}

processResources {
    inputs.property('version', project.mod_version)
    inputs.property('mcversion', project.minecraft_version)
    filesMatching('mcmod.info') {
        expand 'version': project.mod_version, 'mcversion': project.minecraft_version
    }
    duplicatesStrategy = DuplicatesStrategy.INCLUDE
}

test {
    useJUnitPlatform()
    testLogging {
        events 'passed', 'skipped', 'failed'
        showStandardStreams = false
    }
}

// Task to download and extract the Forge API jar from the installer
task setupForge {
    doLast {
        def libsDir = file('libs')
        libsDir.mkdirs()
        def forgeJar = file('libs/forge-1.12.2-14.23.5.2860.jar')
        if (!forgeJar.exists()) {
            def installerUrl = 'https://maven.minecraftforge.net/net/minecraftforge/forge/1.12.2-14.23.5.2860/forge-1.12.2-14.23.5.2860-installer.jar'
            def installerFile = new File(temporaryDir, 'installer.jar')
            new URL(installerUrl).withInputStream { i ->
                installerFile.withOutputStream { it << i }
            }
            project.exec {
                executable 'java'
                args '-jar', installerFile.absolutePath, '--extract', libsDir.absolutePath
            }
            logger.lifecycle("Forge API jar extracted to ${forgeJar}")
        }
    }
}

compileJava.dependsOn setupForge

jar {
    manifest {
        attributes([
            'Specification-Title': "${mod_name}",
            'Specification-Vendor': "${mod_vendor}",
            'Specification-Version': "${version}",
            'Implementation-Title': project.archivesBaseName,
            'Implementation-Version': project.version,
            'Implementation-Vendor': "${mod_vendor}",
            'Implementation-Timestamp': new Date().format("yyyy-MM-dd'T'HH:mm:ssZ")
        ])
    }
}
